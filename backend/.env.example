# ============================================
#  AI Interview Analyzer - Environment Config
# ============================================

# --- REQUIRED ---
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- OPTIONAL ---
# Groq chat model; defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
# Gemini is tried first for audio transcription; Groq Whisper is the fallback.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_AUDIO_MODEL=gemini-3.8-flash
# Optional Groq Whisper model override (default: whisper-large-v3-turbo)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Whisper model size for local fallback: tiny, base, small, medium, large
WHISPER_MODEL=base

# Server config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
